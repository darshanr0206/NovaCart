# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/novacart
DB_USERNAME=postgres
DB_PASSWORD=postgres
DDL_AUTO=update

# ---- JWT ----
# Generate a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-min-256-bits
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@novacart.app

PORT=8080
